# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & API keys
.env
!.env.example

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# Output docx files (keep output directory structure)
output/*.docx
!output/.gitkeep

# Active/Personal resume data & JD files (Keep sample files only in git)
data/resume_data.json
data/resume_static.json
data/resume_static-*.json
data/jd.txt
data/jd.text

# Temporary / Scratch files
*.tmp
data/*_dryrun.tmp
